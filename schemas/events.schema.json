{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dengjihui1/decision-drift/schemas/events.schema.json",
  "title": "Decision Drift Events",
  "type": "object",
  "required": ["events"],
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "observed_at", "source", "facts"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "observed_at": {"type": "string", "format": "date"},
          "source": {"type": "string", "minLength": 1},
          "facts": {"type": "object"},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
